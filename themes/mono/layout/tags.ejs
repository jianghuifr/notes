<div class="tag-cloud-page">
  <h1 class="page-title">标签</h1>
  <div class="tag-cloud">
    <% site.tags.sort('name').each(function(tag){ %>
      <a class="tag-cloud-item" href="<%- url_for(tag.path) %>"><%= tag.name %><span class="tag-cloud-count"><%= tag.posts.length %></span></a>
    <% }) %>
  </div>
</div>

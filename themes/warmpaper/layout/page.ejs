<article class="page-content<% if (page.showProfile) { %> page-about<% } %>">
  <h1><%= page.title %></h1>
  <div class="post-content">
    <%- page.content %>
    <% if (theme.profile && page.showProfile) { %>
      <%- partial('partial/profile') %>
    <% } %>
  </div>

  <% if ((page.math !== undefined) ? page.math : (theme.math && theme.math.enable)) { %>
    <%- partial('partial/math') %>
  <% } %>
</article>

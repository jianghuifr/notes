// ============================================================
// 博客样式：硬朗、极简、纯色背景、系统字体（零外部字体请求）
// ============================================================

// 主题色
$accent = #33ac60;
$accent-dark = darken($accent, 10%);
$border-color-light = #e0e0e0;
$border-color-dark = #3a3a3a;

// 系统字体栈（无外部请求，即开即用）
$font-body = -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
$font-mono = 'SF Mono', 'Cascadia Code', 'Fira Code', 'JetBrains Mono', Menlo, Consolas, 'Courier New', monospace;

// ---------------------------------------------------------------
// 全局：纯色背景，系统字体
// ---------------------------------------------------------------
body {
  background-color: #fafafa;
  background-image: none;
  font-family: $font-body;
  font-size: 15px;
}

@media (prefers-color-scheme: dark) {
  body {
    background-color: #1a1a1a;
    background-image: none;
  }
}

// ---------------------------------------------------------------
// 顶栏 — 去掉渐变，纯色细线
// ---------------------------------------------------------------
.headband {
  height: 3px;
  background: $accent;
  background-size: unset;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 !important;
  margin: 0 !important;
  width: 100% !important;
  border-bottom: 1px solid $border-color-light;
  box-shadow: none;
}

@media (prefers-color-scheme: dark) {
  .header {
    border-bottom-color: $border-color-dark;
    box-shadow: none;
  }
}

.brand {
  background: none !important;
  color: unset;
}

.site-title {
  font-weight: 700 !important;
  font-size: 1.2em !important;
  letter-spacing: 0;
}

// ---------------------------------------------------------------
// 首页文章列表 — 去掉圆角，去掉阴影，细线分隔
// ---------------------------------------------------------------
.posts-expand .post-block {
  margin-bottom: 1.5rem;
  padding: 0 0 1.5rem 0;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  border: none;
  border-bottom: 1px solid $border-color-light;
  transition: none;
}

.posts-expand .post-block:hover {
  box-shadow: none;
  border-color: $accent;
}

.posts-expand .post-block:last-of-type {
  border-bottom: none;
}

@media (prefers-color-scheme: dark) {
  .posts-expand .post-block {
    border-bottom-color: $border-color-dark;
  }
  .posts-expand .post-block:hover {
    box-shadow: none;
    border-color: $accent;
  }
}

.post-block:first-of-type {
  padding-top: 0 !important;
}

// 标题 — 左侧强调线
.posts-expand .post-header {
  font-size: 0.95em;
  margin-bottom: 0.75rem;
  text-align: left;
  padding-left: 0.75rem;
  border-left: 3px solid $accent;
}

.posts-expand .post-title {
  font-weight: 600 !important;
  font-size: 1.2em !important;
  text-align: left;
}

.posts-expand .post-title-link {
  color: var(--text-color) !important;
}

.posts-expand .post-title-link::before {
  background: $accent !important;
  height: 2px;
  border-radius: 0;
}

.posts-expand .post-title-link:hover {
  color: $accent !important;
}

.posts-expand .post-meta-container {
  text-align: left;
  margin-top: 0.35rem;
  font-size: 0.88em;
}

// 摘要与正文
.posts-expand .post-body {
  text-align: left;
  line-height: 1.7;
  font-size: 0.92em;
}

// 阅读更多按钮 — 直角
.posts-expand .post-button .btn {
  border-radius: 0;
  background: $accent !important;
  border: none !important;
  color: #fff !important;
  padding: 0.35em 1em;
  font-size: 0.85em;
  transition: background 0.15s;
}

.posts-expand .post-button .btn:hover {
  background: $accent-dark !important;
  color: #fff !important;
  transform: none;
}

// 文章间分隔线
.post-eof {
  display: none;
}

// 文章内标题 — 系统字体
.post-content h1,
.post-content h2,
.post-content h3,
.post-content h4,
.post-content h5,
.post-content h6 {
  font-weight: 600;
  color: var(--text-color);
}

.post-content h2 {
  font-size: 1.2em;
  border-bottom: 1px solid $border-color-light;
  padding-bottom: 0.3em;
  margin-top: 1.8em;
}

.post-content h3 {
  font-size: 1.05em;
  margin-top: 1.5em;
}

.post-content p {
  line-height: 1.75;
}

// ---------------------------------------------------------------
// 分页 — 去掉圆角
// ---------------------------------------------------------------
.pagination {
  border-top: 1px solid $border-color-light;
  padding-top: 1.5rem;
  margin-top: 1.5rem;
}

@media (prefers-color-scheme: dark) {
  .pagination {
    border-top-color: $border-color-dark;
  }
}

.pagination .prev,
.pagination .next,
.pagination .page-number {
  border-top: none;
  color: $accent;
}

.pagination .page-number:hover {
  color: $accent-dark;
}

.pagination .page-number.current {
  background-color: $accent;
  color: #fff;
  border-radius: 0;
}

// ---------------------------------------------------------------
// 文章页样式
// ---------------------------------------------------------------
.post-body {
  font-size: 0.94em;
  line-height: 1.75;
}

// 链接
.post-content a {
  border-bottom: 1px solid $accent;
  color: $accent-dark;
}

.post-content a:hover {
  border-bottom-color: $accent-dark;
  color: $accent;
}

// 代码块
.code-lang {
  font-size: 0.85em;
}

// 归档页
.posts-collapse .post-content::before {
  background: $accent;
}

.posts-collapse .post-content .post-header {
  border-bottom: none;
}

.collection-title,
.collection-year {
  display: none;
}

// ---------------------------------------------------------------
// 主内容区
// ---------------------------------------------------------------
.main-inner {
  padding-top: 1.5rem;
  padding-bottom: 2rem;
}

.footer {
  border-top: 1px solid $border-color-light;
}

@media (prefers-color-scheme: dark) {
  .footer {
    border-top-color: $border-color-dark;
  }
}

// ---------------------------------------------------------------
// 代码字体
// ---------------------------------------------------------------
code {
  font-family: $font-mono;
  font-size: 0.9em;
}

pre code {
  font-size: 0.85em;
}

// ---------------------------------------------------------------
// 移动端适配
// ---------------------------------------------------------------
@media (max-width: 768px) {
  .posts-expand .post-block {
    padding: 0 0 1.25rem 0;
  }
  .posts-expand .post-header {
    padding-left: 0.6rem;
    border-left-width: 3px;
  }
  .posts-expand .post-title {
    font-size: 1.1em !important;
  }
}
